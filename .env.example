# ============================================================================
# 🔐 SimpleTax 2026 - Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env.local e preencha com suas chaves reais

# ============================================================================
# 📱 APP CONFIG
# ============================================================================
NEXT_PUBLIC_APP_NAME="SimpleTax2026"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="https://simpletax2026.vercel.app"

# ============================================================================
# 🔒 SECURITY
# ============================================================================
# Chave para criptografia de dados sensíveis (use uma aleatória!)
NEXT_PUBLIC_ENCRYPTION_KEY="seu_encryption_key_aqui_min_32_caracteres"

# ============================================================================
# 💰 MONETIZATION - Google AdMob
# ============================================================================
# Obtenha em: https://admob.google.com
NEXT_PUBLIC_ADMOB_APP_ID_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY"
NEXT_PUBLIC_ADMOB_BANNER_ID_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/BBBBBBBBBB"
NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/IIIIIIIIII"

# IDs de Teste (remover em produção)
# NEXT_PUBLIC_ADMOB_BANNER_ID_ANDROID="ca-app-pub-3940256099942544/6300978111"
# NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID="ca-app-pub-3940256099942544/1033173712"

# ============================================================================
# 💳 MONETIZATION - RevenueCat (Assinaturas)
# ============================================================================
# Obtenha em: https://app.revenuecat.com
NEXT_PUBLIC_REVENUECAT_API_KEY_ANDROID="seu_api_key_android_aqui"

# Product IDs (devem corresponder aos IDs no Google Play Console)
NEXT_PUBLIC_PRODUCT_ID_MENSAL="simpletax2026_premium_mensal"
NEXT_PUBLIC_PRODUCT_ID_ANUAL="simpletax2026_premium_anual"
NEXT_PUBLIC_PRODUCT_ID_VITALICIO="simpletax2026_premium_lifetime"

# ============================================================================
# 🗄️ DATABASE - Supabase (Opcional - para sync na nuvem)
# ============================================================================
# Obtenha em: https://supabase.com
# NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="seu_anon_key_aqui"

# ============================================================================
# 📊 ANALYTICS - Google Analytics (Opcional)
# ============================================================================
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ============================================================================
# 🔔 PUSH NOTIFICATIONS - Firebase (Opcional)
# ============================================================================
# NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="simpletax2026"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
# NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:android:abcdef1234567890"

# ============================================================================
# 🎨 FEATURE FLAGS
# ============================================================================
# Habilitar modo premium (para testes)
NEXT_PUBLIC_FORCE_PREMIUM_MODE="false"

# Limite de cálculos gratuitos por mês
NEXT_PUBLIC_FREE_CALCULATIONS_LIMIT="5"

# Mostrar anúncios em desenvolvimento
NEXT_PUBLIC_SHOW_ADS_DEV="false"
